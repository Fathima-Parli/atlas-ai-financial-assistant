# Atlas AI Financial Assistant Configuration

# Application Environment
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Default: zero-config SQLite for immediate local testing
DATABASE_URL=sqlite+aiosqlite:///./atlas_financial.db
# PostgreSQL optional production URL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/atlas_db

# Telegram Bot Token (Optional for web simulator, required for Telegram deployment)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# OpenAI API Key (Optional: Atlas falls back to built-in executive financial AI if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Groq API Key (Optional: Ultra-fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile


# Financial Data APIs (Optional: Built-in Yahoo Finance + SEC Edgar scrapers work automatically)
FINNHUB_API_KEY=your_finnhub_key_here
FMP_API_KEY=your_fmp_key_here

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
